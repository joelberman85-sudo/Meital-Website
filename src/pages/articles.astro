---
// /articles: every guide in one place. The guides used to sit on the homepage under
// "מחשבות על..."; the homepage now keeps only the four essays, and the menu links here.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { waHref } from '../data/site.js';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="מאמרים על פסיכותרפיה | מיטל עוז"
  description="מאמרים ומדריכים של מיטל עוז, פסיכותרפיסטית בתל אביב: חרדה, דיכאון, טראומה, דימוי עצמי, גבולות ביחסים, ADHD ואיך בוחרים מטפל."
  path="/articles"
>
  <section class="relative pt-[112px] md:pt-[128px] pb-20 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <Reveal>
        <div class="text-center">
          <span class="pill-label" style="background-color: rgb(231, 236, 222);">קריאה</span>
          <h1 class="display mt-5 text-[34px] sm:text-[44px] md:text-[52px]">מאמרים</h1>
        </div>
      </Reveal>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
          guides.map((g) => (
            <a
              href={`/${g.id}`}
              class="card lift-hover group h-full px-7 py-7 flex flex-col text-right"
            >
              <h2 class="font-bold text-ink text-[19px] md:text-[20px] leading-snug">
                {g.data.title}
              </h2>
              <p class="mt-3 text-[15px] text-ink-soft leading-[1.8] grow">{g.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[14px] text-cta font-semibold group-hover:gap-3 transition-all">
                לקריאה <Icon name="ArrowL" size={14} />
              </span>
            </a>
          ))
        }
      </div>

      <Reveal class="mt-16">
        <div class="flex justify-center">
          <span class="pill-label" style="background-color: rgb(231, 236, 222);">מחשבות על...</span>
        </div>
        <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5 md:gap-6">
          {
            articles.map((a) => (
              <a
                href={`/${a.id}`}
                class="group relative aspect-[3/4] rounded-[24px] overflow-hidden shadow-soft lift-hover"
              >
                <img
                  src={a.data.image}
                  alt={a.data.imageAlt || a.data.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-[1.05]"
                />
                <div
                  class="absolute inset-0"
                  style="background: linear-gradient(to top, rgba(40,30,24,.82) 0%, rgba(40,30,24,.28) 42%, rgba(40,30,24,.05) 70%);"
                />
                <div class="absolute inset-x-0 bottom-0 p-6 text-right">
                  <h2 class="text-white font-bold text-[20px] leading-tight">{a.data.title}</h2>
                  <span class="mt-3 inline-flex items-center gap-2 text-[14px] text-white/90 font-semibold group-hover:gap-3 transition-all">
                    קראו עוד <Icon name="ArrowL" size={14} />
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </Reveal>

      <CTABand
        class="mt-16"
        title="אני כאן בשבילך"
        sub="מוזמנים להתייעץ, בלי התחייבות ובקצב שלכם."
        btn="בואו נתחיל בשיחה"
        href={waHref}
      />
    </div>
  </section>
</BaseLayout>
