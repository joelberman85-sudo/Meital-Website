---
// /articles: every guide in one place. The guides used to sit on the homepage under
// "מחשבות על..."; the homepage keeps only Maytal's four essays, and the menu links here.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { waHref } from '../data/site.js';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="מאמרים על פסיכותרפיה | מיטל עוז"
  description="מאמרים ומדריכים של מיטל עוז, פסיכותרפיסטית בתל אביב: חרדה, דיכאון, טראומה, דימוי עצמי, גבולות ביחסים, ADHD ואיך בוחרים מטפל."
  path="/articles"
>
  <section class="relative pt-[112px] md:pt-[128px] pb-20 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <Reveal>
        <div class="text-center">
          <span class="pill-label" style="background-color: rgb(231, 236, 222);">קריאה</span>
          <h1 class="display mt-5 text-[34px] sm:text-[44px] md:text-[52px]">מאמרים</h1>
          <p class="mt-4 text-[16px] text-ink-soft leading-[1.8]">
            קשה לכם לשים גבולות? כתבתי על כך <a href="/healthy-boundaries-in-relationships-psychotherapy" style="text-decoration: underline">גבולות בריאים במערכות יחסים: איך פסיכותרפיה עוזרת לשים גבולות?</a>
          </p>
        </div>
      </Reveal>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
          guides.map((g) => (
            <a
              href={`/${g.id}`}
              class="card lift-hover group h-full px-7 py-7 flex flex-col text-right"
            >
              <h2 class="font-bold text-ink text-[19px] md:text-[20px] leading-snug">
                {g.data.title}
              </h2>
              <p class="mt-3 text-[15px] text-ink-soft leading-[1.8] grow">{g.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[14px] text-cta font-semibold group-hover:gap-3 transition-all">
                לקריאה <Icon name="ArrowL" size={14} />
              </span>
            </a>
          ))
        }
      </div>

      <CTABand
        class="mt-16"
        title="אני כאן בשבילך"
        sub="מוזמנים להתייעץ, בלי התחייבות ובקצב שלכם."
        btn="בואו נתחיל בשיחה"
        href={waHref}
      />
    </div>
  </section>
</BaseLayout>
