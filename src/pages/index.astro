---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CrisisIntro from '../components/CrisisIntro.astro';
import About from '../components/About.astro';
import QuoteBand from '../components/QuoteBand.astro';
import SpecialtiesStrip from '../components/SpecialtiesStrip.astro';
import Approach from '../components/Approach.astro';
import Thoughts from '../components/Thoughts.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="מיטל עוז | פסיכותרפיסטית וקרימינולוגית | תל אביב"
  description="פסיכותרפיה קיומית בגובה העיניים עם מיטל עוז, פסיכותרפיסטית וקרימינולוגית M.A. ליווי בחרדה, דיכאון, בדידות, התמכרויות וטראומה. קליניקה בתל אביב וגם בזום."
  path="/"
>
  <Hero />
  <CrisisIntro />
  <About />
  <QuoteBand style="background-color: rgb(231, 236, 222);">
    אני מאמינה שטיפול רגשי צריך להיות — בגובה העיניים, ומחובר למציאות היום-יומית. למי שמתקשה להרגיש בנוח בין אנשים, כתבתי על <a href="https://maytaloz.com/social-anxiety-psychotherapy-tel-aviv" style="text-decoration: underline">פסיכותרפיה לחרדה חברתית</a>. ולמי שנושא חוויות קשות מהעבר, כתבתי על <a href="https://maytaloz.com/trauma-ptsd-psychotherapy" style="text-decoration: underline">טראומה ו-PTSD ואיך פסיכותרפיה יכולה לעזור לעבד אותן</a>. ולמי שמרגיש עצב שלא עובר, כתבתי על <a href="https://maytaloz.com/depression-chronic-sadness-psychotherapy" style="text-decoration: underline">דיכאון ועצב כרוני ומתי כדאי לפנות לפסיכותרפיה</a>. ולמי שמתקשה להאמין בעצמו, כתבתי על <a href="https://maytaloz.com/low-self-esteem-psychotherapy-self-confidence" style="text-decoration: underline">דימוי עצמי נמוך ואיך פסיכותרפיה יכולה לעזור לבנות ביטחון עצמי</a>. ולמי שמתקשה לומר לא ולשמור על עצמו בקשר, כתבתי על <a href="https://maytaloz.com/healthy-boundaries-in-relationships-psychotherapy" style="text-decoration: underline">גבולות בריאים במערכות יחסים ואיך פסיכותרפיה עוזרת לשים גבולות</a>. ולמי שמתלבט איך לבחור מטפל בכלל, כתבתי על <a href="https://maytaloz.com/how-to-choose-a-psychotherapist-tel-aviv" style="text-decoration: underline">פסיכותרפיה בתל אביב ואיך בוחרים פסיכותרפיסט שמתאים לכם</a>.
  </QuoteBand>
  <SpecialtiesStrip />
  <Approach />
  <Thoughts />
  <ContactForm />
</BaseLayout>
