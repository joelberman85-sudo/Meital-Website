---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CrisisIntro from '../components/CrisisIntro.astro';
import About from '../components/About.astro';
import QuoteBand from '../components/QuoteBand.astro';
import SpecialtiesStrip from '../components/SpecialtiesStrip.astro';
import Approach from '../components/Approach.astro';
import Thoughts from '../components/Thoughts.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="מיטל עוז | פסיכותרפיסטית וקרימינולוגית | תל אביב"
  description="פסיכותרפיה קיומית בגובה העיניים עם מיטל עוז, פסיכותרפיסטית וקרימינולוגית M.A. ליווי בחרדה, דיכאון, בדידות, התמכרויות וטראומה. קליניקה בתל אביב וגם בזום."
  path="/"
>
  <Hero />
  <CrisisIntro />
  <About />
  <QuoteBand style="background-color: rgb(231, 236, 222);">
    אני מאמינה שטיפול רגשי צריך להיות — בגובה העיניים, ומחובר למציאות היום-יומית.
  </QuoteBand>
  <SpecialtiesStrip />
  <Approach />
  <Thoughts />
  <ContactForm />
</BaseLayout>
