---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CrisisIntro from '../components/CrisisIntro.astro';
import About from '../components/About.astro';
import QuoteBand from '../components/QuoteBand.astro';
import SpecialtiesStrip from '../components/SpecialtiesStrip.astro';
import Approach from '../components/Approach.astro';
import Thoughts from '../components/Thoughts.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="מיטל עוז | פסיכותרפיסטית וקרימינולוגית | תל אביב"
  description="פסיכותרפיסטית וקרימינולוגית M.A. גישה קיומית-אקזיסטנציאליסטית, בגובה העיניים. ליווי בחרדה, בדידות, התמכרויות וטראומה. קליניקה במרכז תל אביב וזום."
  path="/"
>
  <Hero />
  <CrisisIntro />
  <About />
  <QuoteBand style="background-color: rgb(231, 236, 222);">
    אני מאמינה שטיפול רגשי צריך להיות — בגובה העיניים, ומחובר למציאות היום-יומית. גם מי שחי בתוך זוגיות יכול להרגיש לבד, וכתבתי על <a href="/emotional-loneliness-psychotherapy-tel-aviv" style="text-decoration: underline">בדידות רגשית ואיך פסיכותרפיה יכולה לעזור</a>. מתעניינים בגישה הקיומית? <a href="/existential-therapy-faq" style="text-decoration: underline">שאלות נפוצות על טיפול אקזיסטנציאליסטי</a>.
  </QuoteBand>
  <SpecialtiesStrip />
  <Approach />
  <Thoughts />
  <ContactForm />
</BaseLayout>
