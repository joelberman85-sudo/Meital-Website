---
// Thoughts — calm image cards (carousel). Ported from app.jsx:545-712.
// The reader modal is gone: each essay now has a real URL, so the cards are links.
import { getCollection } from 'astro:content';
import Reveal from './Reveal.astro';
import CTABand from './CTABand.astro';
import Icon from './Icon.astro';
import { waHref } from '../data/site.js';

const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---

<section id="thoughts" class="relative py-20 md:py-28 bg-cream-2">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
    <div class="flex items-end justify-between gap-6 mb-12">
      <Reveal>
        <span class="pill-label" style="background-color: rgb(231, 236, 222);">קריאה</span>
        <h2 class="display mt-5 text-[34px] sm:text-[44px] md:text-[52px]">מחשבות על...</h2>
      </Reveal>
      <div class="hidden sm:flex items-center gap-2 shrink-0">
        <button
          id="thoughts-prev"
          type="button"
          aria-label="הקודם"
          class="w-12 h-12 rounded-full border border-sage text-sage-deep bg-card grid place-items-center hover:bg-sage-deep hover:text-white hover:border-sage-deep transition"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>
        <button
          id="thoughts-next"
          type="button"
          aria-label="הבא"
          class="w-12 h-12 rounded-full border border-sage text-sage-deep bg-card grid place-items-center hover:bg-sage-deep hover:text-white hover:border-sage-deep transition"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
          >
        </button>
      </div>
    </div>

    <div
      id="thoughts-strip"
      class="thoughts-strip flex gap-6 overflow-x-auto pb-4 -mx-6 px-6 lg:-mx-10 lg:px-10 snap-x snap-mandatory"
      style="scrollbar-width: none;"
    >
      {
        articles.map((a) => (
          <a
            href={`/${a.id}`}
            data-card
            class="group relative shrink-0 snap-start w-[78%] sm:w-[330px] md:w-[360px] aspect-[3/4] rounded-[24px] overflow-hidden cursor-pointer shadow-soft lift-hover"
          >
            <img
              src={a.data.image}
              alt={a.data.imageAlt || ''}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-[1.05]"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to top, rgba(40,30,24,.82) 0%, rgba(40,30,24,.28) 42%, rgba(40,30,24,.05) 70%);"
            />
            <div class="absolute inset-x-0 bottom-0 p-6 text-right">
              <h3 class="text-white font-bold text-[21px] md:text-[23px] leading-tight">
                {a.data.title}
              </h3>
              <span class="mt-3 inline-flex items-center gap-2 text-[14px] text-white/90 font-semibold group-hover:gap-3 transition-all">
                קראו עוד <Icon name="ArrowL" size={14} />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Guides. Previously orphan pages at the repo root that nothing linked to. -->
    <Reveal class="mt-16">
      <div class="flex justify-center">
        <span class="pill-label" style="background-color: rgb(231, 236, 222);">מדריכים</span>
      </div>
      <div class="mt-7 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
          guides.map((g) => (
            <a
              href={`/${g.id}`}
              class="card lift-hover group h-full px-7 py-7 flex flex-col text-right"
            >
              <h3 class="font-bold text-ink text-[19px] md:text-[20px] leading-snug">
                {g.data.title}
              </h3>
              <p class="mt-3 text-[15px] text-ink-soft leading-[1.8] grow">{g.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-[14px] text-cta font-semibold group-hover:gap-3 transition-all">
                לקריאה <Icon name="ArrowL" size={14} />
              </span>
            </a>
          ))
        }
      </div>
    </Reveal>

    <CTABand
      class="mt-16"
      title="אני כאן בשבילך"
      sub="מוזמנים להתייעץ — בלי התחייבות, בקצב שלכם."
      btn="בואו נתחיל בשיחה"
      href={waHref}
    />
  </div>
</section>

<script>
  // Carousel scroll buttons — ported from scrollByCard() in app.jsx:550-566.
  (() => {
    const el = document.getElementById('thoughts-strip');
    const prev = document.getElementById('thoughts-prev');
    const next = document.getElementById('thoughts-next');
    if (!el || !prev || !next) return;

    const scrollByCard = (dir) => {
      const card = el.querySelector('[data-card]');
      const step = card ? card.getBoundingClientRect().width + 24 : 340;
      const target = el.scrollLeft + dir * -step;
      const steps = 18;
      let i = 0;
      const from = el.scrollLeft;
      const timer = setInterval(() => {
        i++;
        const p = i / steps;
        const ease = 1 - Math.pow(1 - p, 3);
        el.scrollLeft = from + (target - from) * ease;
        if (i >= steps) clearInterval(timer);
      }, 16);
    };

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
  })();
</script>
