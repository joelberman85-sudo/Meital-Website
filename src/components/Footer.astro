---
// Footer — ported verbatim from the `Footer` function in app.jsx:817-859.
import Icon from './Icon.astro';
import BrandMark from './BrandMark.astro';
import { CONTACT, waHref, telHref } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="bg-cream-2 pt-20 pb-32 md:pb-16 relative border-t border-line">
  <div class="max-w-[1180px] mx-auto px-6 text-center">
    <BrandMark size={66} class="mx-auto" />
    <div class="mt-4 font-bold text-ink text-[24px]">מיטל עוז · M.A</div>
    <p class="mt-3 italic text-[17px] text-ink-soft max-w-md mx-auto leading-relaxed">
      ״טיפול רגשי בגובה העיניים, מחובר למציאות היום-יומית — ובקצב שלך.״
    </p>

    <div class="mt-7 flex items-center justify-center gap-4">
      <a href={CONTACT.facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook"
      class="w-11 h-11 rounded-full border border-sage text-sage-deep grid place-items-center hover:bg-sage-deep hover:text-white hover:border-sage-deep transition">
        <Icon name="Facebook" size={18} stroke={0} />
      </a>
      <a href={CONTACT.instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram"
      class="w-11 h-11 rounded-full border border-sage text-sage-deep grid place-items-center hover:bg-sage-deep hover:text-white hover:border-sage-deep transition">
        <Icon name="Instagram" size={18} />
      </a>
      <a href={waHref} target="_blank" rel="noreferrer" aria-label="WhatsApp"
      class="w-11 h-11 rounded-full border border-sage text-sage-deep grid place-items-center hover:bg-sage-deep hover:text-white hover:border-sage-deep transition">
        <Icon name="Whatsapp" size={18} stroke={0} />
      </a>
    </div>

    <a href={telHref} class="mt-6 inline-block font-bold text-cta text-[22px] tracking-wide" dir="ltr">
      {CONTACT.phone}
    </a>

    <nav class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-[14.5px] text-ink-soft">
      <a href="#about" class="hover:text-cta transition">אודות</a>
      <a href="#approach" class="hover:text-cta transition">הגישה הטיפולית</a>
      <a href="#thoughts" class="hover:text-cta transition">מחשבות על...</a>
      <a href="#contact" class="hover:text-cta transition">יצירת קשר</a>
      <a href={CONTACT.tvUrl} target="_blank" rel="noreferrer" class="hover:text-cta transition">כתבה בחדשות 13</a>
    </nav>

    <div class="mt-9 pt-6 border-t border-line text-[12.5px] text-ink-mute">
      © {year} מיטל עוז · כל הזכויות שמורות · {CONTACT.email}
    </div>
  </div>
</footer>
